node_modules/
*.vsix
dist/
.trae/
*.log

# 构建产物：由 `npm run build` 生成，源码是唯一事实来源
out/
media/worktable.js
media/worktable.css

# TraeWork 工作台的本地数据：记录的是本机项目绝对路径，属本地实例数据，不入库
.worktable/

# workbench/ 的本地实例数据：内嵌本机真实路径，同样不入库
workbench/workbench.html
workbench/workbench.registry.json
workbench/build/data/

# 本地调试探针与上游解包参照物：一次性排障产物，不入库
.tmp-*
dsh/.tmp-pings.jsonl

# 安装包 / 分享产物：由 `npm pack`、发布流程生成，不入库
*.tgz
*.genie

# 本地 agent 工作目录（记忆、会话数据）
.workbuddy/
